NODE_ENV=development
PORT=3000
DATABASE_URL=
# Provide the public database CA as PEM (Heroku uses SUPABASE_CA_CERT) or a local path.
SUPABASE_CA_CERT=
PGSSLROOTCERT=
# Also supported: DATABASE_SSL_ROOT_CERT for PEM, DATABASE_CA_PATH for a file path.
SKWID_ADMIN_TOKEN=
SKWID_PUBLIC_URL=
SKWID_WEBSITE_URL=
SKWID_X_URL=
SKWID_GITHUB_URL=

SKWID_CHAIN_ID=4663
SKWID_CHAIN_NAME=Robinhood Chain
SKWID_RPC_URL=https://rpc.mainnet.chain.robinhood.com
SKWID_EXPLORER_URL=https://robinhoodchain.blockscout.com
SKWID_TOKEN_ADDRESS=
SKWID_TOKEN_EXPLORER_URL=
SKWID_TREASURY_ADDRESS=
SKWID_RELEASE_REGISTRY_ADDRESS=
SKWID_REGISTRY_OPERATOR_ADDRESS=
SKWID_PONS_FACTORY_ADDRESS=0xA5aAb3F0c6EeadF30Ef1D3Eb997108E976351feB
SKWID_PONS_LOCKER_ADDRESS=0x736D76699C26D0d966744cAe304C000d471f7F35
# Enable only after the candidate collectFees(address) ABI is verified for the actual token/version.
SKWID_PONS_COLLECTION_ABI_VERIFIED=false
SKWID_PONS_OPERATOR_ADDRESS=

# Optional OpenAI-compatible planning adapter. Owner-supplied changes work without it.
SKWID_MODEL_API_KEY=
SKWID_MODEL=
SKWID_MODEL_BASE_URL=https://api.openai.com/v1
SKWID_MODEL_TIMEOUT_MS=60000

SKWID_REPO_ROOT=
SKWID_WORK_ROOT=
SKWID_ALLOWED_ROOTS=["public/","server/"]
SKWID_CONTEXT_FILES=["README-backend.md","package.json"]
SKWID_FIXED_CHECKS=[["npm","test"]]
# docker executes fixed operator checks in a sandbox; syntax only parses changed source.
SKWID_CHECK_MODE=docker
# Required for execution and must include an immutable sha256 digest.
SKWID_RUNNER_IMAGE=node:22-alpine@sha256:REPLACE_WITH_REVIEWED_DIGEST
SKWID_MAX_CHANGE_FILES=8
SKWID_MAX_CHANGE_BYTES=100000
SKWID_CHECK_TIMEOUT_MS=120000
SKWID_RUN_LEASE_SECONDS=300
